@model List<(string, string, string)>

@* Main Carousel *@
<div id="carouselComponent" class="carousel slide main-carousel-container" data-bs-ride="false">
    @* Indicators *@
    <div class="carousel-indicators">
        @foreach (var index in Model.Select((_, index) => index))
        {
            <button type="button" data-bs-target="#carouselComponent" data-bs-slide-to="@index"
                    class="@(index == 0 ? "active" : "")" aria-label="Slide @(index + 1)">
            </button>
        }
    </div>

    @* Media Items *@
    <div class="carousel-inner main-carousel-inner">
        @foreach (var (mediaType, mediaUrl, mediaOrientation, index) in Model.Select((item, index) => (item.Item1, item.Item2, item.Item3, index)))
        {
            <div class="carousel-item @(index == 0 ? "active" : "")">
            @if (mediaType == "image")
            {
                <img src="@mediaUrl" class="main-carousel-img"
                     data-bs-toggle="modal" data-bs-target="#fullscreenModal"
                     data-src="@mediaUrl" data-index="@index" alt="GnollHack Screenshot @(index + 1)"
                     loading="@(index == 0 ? "eager" : "lazy")"
                     fetchpriority="@(index == 0 ? "auto" : "low")">
            }
            else if (mediaType == "video")
            {
                <div class="video-poster-container main-carousel-video-container @(mediaOrientation == "landscape" ? "main-carousel-video-landscape" : "main-carousel-video-portrait")"
                     data-bs-toggle="modal" data-bs-target="#fullscreenModal"
                     data-video-id="@mediaUrl" data-index="@index"
                     role="button" tabindex="0" aria-label="Open fullscreen video @(index + 1)">
                    <img class="video-poster-img"
                         src="https://img.youtube.com/vi/@mediaUrl/maxresdefault.jpg"
                         alt="GnollHack Video Poster @(index + 1)"
                         loading="lazy" width="1280" height="720">
                    <button type="button" class="video-play-btn" aria-label="Play Video" tabindex="-1">
                        <svg viewBox="0 0 68 48" class="video-play-icon" width="68" height="48" aria-hidden="true">
                            <path class="video-play-bg" d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#f00"/>
                            <path d="M45 24 27 14v20" fill="#fff"/>
                        </svg>
                    </button>
                </div>
            }
            </div>
        }
    </div>

    @* Navigation Buttons *@
    <button class="carousel-control-prev main-carousel-control-prev" type="button" data-bs-target="#carouselComponent" data-bs-slide="prev" aria-label="Previous Slide">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    </button>

    <button class="carousel-control-next main-carousel-control-next" type="button" data-bs-target="#carouselComponent" data-bs-slide="next" aria-label="Next Slide">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
    </button>
</div>
