@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <h1 class="text-danger my-4">An Error Occurred</h1>
    <p class="lead">Something went wrong while processing your request.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            <small>Request ID: <code>@Model.RequestId</code></small>
        </p>
    }

    <div class="mt-4">
        <a href="/" class="btn btn-outline-light">Return to Homepage</a>
    </div>
</div>
