@page
@model IndexModel
@{
    ViewData["Title"] = "";
}

<section id="top" class="hero">
    <picture class="hero-art">
        <source media="(min-width: 768px)"
                srcset="@Url.Content("~/img/hero-ranger-landscape-w1280.webp") 1280w, @Url.Content("~/img/hero-ranger-landscape-w1920.webp") 1920w, @Url.Content("~/img/hero-ranger-landscape-w2560.webp") 2560w"
                sizes="min(100vw, 2560px)" width="2560" height="1637" />
        <source media="(max-width: 767.98px)"
                srcset="@Url.Content("~/img/hero-ranger-portrait-w750.webp") 750w, @Url.Content("~/img/hero-ranger-portrait-w1080.webp") 1080w"
                sizes="100vw" width="1080" height="1620" />
        <img src="~/img/hero-ranger-landscape-w1920.webp" alt="A hooded ranger with a glowing arrow in a misty cave" fetchpriority="high" width="2560" height="1637" />
    </picture>
    <div class="hero-content">
        <img src="~/img/gnollhack-icon-v2-512.webp" alt="" width="512" height="512" class="hero-crest" />
        <h1 class="hero-title">
            <span class="hero-wordmark">GnollHack</span>
            <span class="hero-slogan">The Modern Way to Play NetHack</span>
        </h1>
        <div class="hero-actions">
            <a href="#download" class="hero-cta hero-cta-primary">Download for Free</a>
            <a href="#media" class="hero-cta hero-cta-secondary">Watch Trailers</a>
        </div>
        <p class="hero-platforms">Free on Windows, macOS, Linux, Steam Deck, iOS, and Android</p>
    </div>
</section>

<section id="download" class="right-section orc-assassin">
    <div class="backdrop">
        <div class="features-text">
            <div class="section-block">
                <h2>Download</h2>
                <div class="download-panel">
                    <p class="panel-lead">No ads, paywalls, or microtransactions.</p>

                    <ul class="download-grid" role="list">
                        <li class="download-item">
                            <a class="download-badge-link" href="https://store.steampowered.com/app/3558190/GnollHack/?utm_source=gnollhack" aria-describedby="plat-steam">
                                <img src="~/img/steambadge-noborders.webp" alt="Available on Steam" loading="lazy" width="556" height="160" class="shiny-borders steam" />
                            </a>
                            <span id="plat-steam" class="download-platform">Windows, Linux &amp; Steam Deck</span>
                        </li>

                        <li class="download-item">
                            <a class="download-badge-link" href="https://apps.apple.com/app/gnollhack/id1626979951?utm_source=gnollhack" aria-describedby="plat-app-store">
                                <img src="~/img/app-store-badge-h200-noborders.webp" alt="Download on the App Store" loading="lazy" width="617" height="200" class="shiny-borders apple-app-store" />
                            </a>
                            <span id="plat-app-store" class="download-platform">iOS, iPadOS &amp; macOS</span>
                        </li>

                        <li class="download-item">
                            <a class="download-badge-link" href="https://play.google.com/store/apps/details?id=com.soundmindentertainment.gnollhack&utm_source=gnollhack" aria-describedby="plat-google-play">
                                <img src="~/img/google-play-badge-noborders.webp" alt="Get it on Google Play" loading="lazy" width="556" height="160" class="shiny-borders google-play" />
                            </a>
                            <span id="plat-google-play" class="download-platform">Android Phones &amp; Tablets</span>
                        </li>

                        <li class="download-item">
                            <a class="download-badge-link" href="https://github.com/hyvanmielenpelit/GnollHack/releases" aria-describedby="plat-github">
                                <img src="~/img/GitHubDownloadBadge-NoBorders-h200.webp" alt="Get release on GitHub" loading="lazy" width="622" height="200" class="shiny-borders github-releases" />
                            </a>
                            <span id="plat-github" class="download-platform">Windows &amp; Linux Downloads</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div id="about" class="section-block">
                <h2>What is GnollHack?</h2>
                <div class="intro-card">
                    <p class="intro-copy">
                        GnollHack is a modernization of <a href="https://www.nethack.org" target="_blank" rel="noopener noreferrer" class="inline-accent">NetHack</a>,
                        one of the deepest turn-based dungeon crawlers of all time. The classic dungeon branches, game interactions, and tactical depth are all here, backed by artist-drawn graphics, full voice acting, original music, and native touch, mouse, keyboard, and controller support.
                    </p>
                    <p class="intro-copy intro-links">
                        New to the Dungeons of Doom? Browse the <a href="https://wiki.gnollhack.com" target="_blank" rel="noopener noreferrer" class="inline-accent">GnollHack Wiki</a> for item, spell, and class reference guides, or ask the <a href="https://overseer.gnollhack.com" target="_blank" rel="noopener noreferrer" class="inline-accent">Gnoll Overseer</a> for advice during your run.
                    </p>
                    <blockquote class="praise-quote">
                        <p>&ldquo;This is, by far, the best NetHack rendition I have ever played.&rdquo;</p>
                        <div class="praise-cite"><strong>Player Review on Steam</strong> <span class="praise-stars" role="img" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span></div>
                    </blockquote>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="media" class="left-section orc-hunter">
    <div class="backdrop">
        <div class="features-text">
            <h2>Gameplay &amp; Trailers</h2>
            <p class="section-lead">Watch the trailers or open any screenshot in fullscreen.</p>
            <div class="carousel-container">
                @await Html.PartialAsync("_Carousel", Model.MediaItems)
            </div>
        </div>
    </div>
</section>

<section id="features" class="right-section female-mage">
    <div class="backdrop">
        <div class="features-text">
            <h2>Features</h2>
            <div class="feature-stack">
                <article class="feature-card">
                    <div class="imgContainer">
                        <img src="~/img/human_wizard_female.webp" alt="Human Wizard" loading="lazy" width="64" height="96" />
                    </div>
                    <h3>Graphics, Voice &amp; Audio</h3>
                    <ul class="feature-list" role="list">
                        <li><strong>Hand-Crafted Pixel Art.</strong> Over 23,000 animated dungeon, monster, and item tiles drawn by human artists, with zero AI-generated in-game art.</li>
                        <li><strong>Full Voice Acting.</strong> More than 5,000 voiced lines performed by 96 actors bring shopkeepers, quest leaders, and bosses to life.</li>
                        <li><strong>Comprehensive Soundtrack and Sound Effects.</strong> A 37-track fantasy score and over 1,100 sound effects.</li>
                    </ul>
                </article>

                <article class="feature-card">
                    <div class="imgContainer">
                        <img src="~/img/human_rogue_male.webp" alt="Human Rogue" loading="lazy" width="64" height="96" />
                    </div>
                    <h3>Controls &amp; Accessibility</h3>
                    <ul class="feature-list" role="list">
                        <li><strong>Built for Every Screen.</strong> Play natively with touch controls on phones and tablets, mouse and keyboard on PC, or gamepad on Steam Deck.</li>
                        <li><strong>Readable Modern Interface.</strong> Intuitive context menus replace cryptic keystroke memorization.</li>
                        <li><strong>Optional AI Advisor.</strong> Ask the Gnoll Overseer for advice about game mechanics or your current game situation without tabbing out of the dungeon.</li>
                    </ul>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="left-section barbarian">
    <div class="backdrop">
        <div class="features-text">
            <h2>Replayability &amp; Freedom</h2>
            <div class="feature-stack">
                <article class="feature-card">
                    <div class="imgContainer">
                        <img src="~/img/gnoll_barbarian_male.webp" alt="Gnoll Barbarian" loading="lazy" width="64" height="96" />
                    </div>
                    <h3>Expanded Dungeon Depth</h3>
                    <ul class="feature-list" role="list">
                        <li><strong>13 Roles &amp; 5 Playable Races.</strong> Descend as a Wizard, Valkyrie, Rogue, or Priest, or play as a Gnoll with distinct racial traits.</li>
                        <li><strong>Reagent-Driven Magic.</strong> Prepare over 200 spells with alchemical reagents.</li>
                        <li><strong>Unique Runs That Reward Mastery.</strong> Randomized floors, rooms, and monsters test strategy rather than reflexes.</li>
                    </ul>
                </article>

                <article class="feature-card">
                    <div class="imgContainer">
                        <img src="~/img/stormbringer.webp" alt="Stormbringer" loading="lazy" width="64" height="48" />
                    </div>
                    <h3>Flexible Modes &amp; Open Source</h3>
                    <ul class="feature-list" role="list">
                        <li><strong>Seven Difficulty Tiers.</strong> Start on gentler settings while learning the ropes, or take on unforgiving veteran challenges.</li>
                        <li><strong>Classic Permadeath or Reloadable Saves.</strong> Commit to traditional single-life ascensions or play in modes that allow saving and reloading.</li>
                        <li><strong>Cloud Sync &amp; Shared Bones.</strong> Transfer active runs between devices and encounter the haunted remains of fallen players.</li>
                        <li><strong>100% Free &amp; Open Source.</strong> Developed in the open by Finnish non-profit Sound Mind Games, with no ads, paywalls, or microtransactions.</li>
                    </ul>
                </article>
            </div>
        </div>
    </div>
</section>

<section id="community" class="right-section dwarf-monk">
    <div class="backdrop">
        <div class="features-text">
            <div class="section-block">
                <h2>Learn the Game</h2>
                <ul class="resource-grid" role="list">
                    <li class="resource-card">
                        <a class="resource-link" href="https://wiki.gnollhack.com" target="_blank" rel="noopener noreferrer" aria-describedby="desc-gh-wiki">GnollHack Wiki</a>
                        <span id="desc-gh-wiki" class="resource-desc">Classes, items, monsters, spells &amp; strategy guides</span>
                        <span class="resource-arrow" aria-hidden="true">&#8599;</span>
                    </li>
                    <li class="resource-card">
                        <a class="resource-link" href="https://overseer.gnollhack.com" target="_blank" rel="noopener noreferrer" aria-describedby="desc-overseer">Gnoll Overseer</a>
                        <span id="desc-overseer" class="resource-desc">Optional real-time AI advisor</span>
                        <span class="resource-arrow" aria-hidden="true">&#8599;</span>
                    </li>
                    <li class="resource-card">
                        <a class="resource-link" href="https://nethackwiki.com" target="_blank" rel="noopener noreferrer" aria-describedby="desc-nh-wiki">NetHack Wiki</a>
                        <span id="desc-nh-wiki" class="resource-desc">Classic NetHack lore, mechanics &amp; ascension knowledge</span>
                        <span class="resource-arrow" aria-hidden="true">&#8599;</span>
                    </li>
                </ul>
            </div>

            <div class="section-block">
                <h2>Community</h2>
                <ul class="resource-grid" role="list">
                    <li class="resource-card">
                        <a class="resource-link" href="https://discord.gg/cQuExnzUQy" target="_blank" rel="noopener noreferrer" aria-describedby="desc-discord">GnollHack Discord</a>
                        <span id="desc-discord" class="resource-desc">Discuss strategy, report issues &amp; talk to the developers</span>
                        <span class="resource-arrow" aria-hidden="true">&#8599;</span>
                    </li>
                    <li class="resource-card">
                        <a class="resource-link" href="https://account.gnollhack.com" target="_blank" rel="noopener noreferrer" aria-describedby="desc-account">GnollHack Account</a>
                        <span id="desc-account" class="resource-desc">Global scoreboards</span>
                        <span class="resource-arrow" aria-hidden="true">&#8599;</span>
                    </li>
                    <li class="resource-card">
                        <a class="resource-link" href="https://github.com/hyvanmielenpelit/GnollHack" target="_blank" rel="noopener noreferrer" aria-describedby="desc-github">GitHub Repository</a>
                        <span id="desc-github" class="resource-desc">Open-source codebase &amp; release notes</span>
                        <span class="resource-arrow" aria-hidden="true">&#8599;</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("_FullscreenModal", Model.MediaItems)

@section Styles {
    <link rel="stylesheet" href="~/css/carousel.min.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/carousel.js" asp-append-version="true" type="text/javascript"></script>
}
