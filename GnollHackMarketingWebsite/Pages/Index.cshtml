@page
@model IndexModel
@{
    ViewData["Title"] = "";
}

<h1 class="visually-hidden">GnollHack &ndash; The Modern Way to Play NetHack</h1>

<section class="main-section">
    <picture>
        <source media="(min-width: 768px)" srcset="~/img/gnollhack-image-landscape-w2560.webp" width="2560" height="1440" />
        <source media="(max-width: 767.98px)" srcset="~/img/gnollhack-image-portrait-w1080.webp" width="1080" height="1920" />
        <img src="~/img/gnollhack-image-landscape-w2560.webp" alt="GnollHack" fetchpriority="high" width="2560" height="1440" class="hero-picture" />
    </picture>
</section>

<section class="right-section orc-assassin">
    <div class="backdrop">
        <div class="features-text">
            <h2>Download</h2>
            <h4>Available for <span class="free">free</span> on Android, iOS, Linux, macOS, and Windows!</h4>

            <div class="download-link-outer-container">
                <div class="download-link-container" data-bs-toggle="tooltip" data-bs-placement="top"
                     data-bs-custom-class="download-link-tooltip"
                     data-bs-title="Android">
                    <a href="https://play.google.com/store/apps/details?id=com.soundmindentertainment.gnollhack&utm_source=gnollhack"><img src="~/img/google-play-badge-noborders.webp" alt="Get it on Google Play" loading="lazy" class="shiny-borders google-play" /></a>
                </div>
            </div>

            <div class="download-link-outer-container">
                <div class="download-link-container" data-bs-toggle="tooltip" data-bs-placement="top"
                     data-bs-custom-class="download-link-tooltip"
                     data-bs-title="iOS & macOS">
                    <a href="https://apps.apple.com/app/gnollhack/id1626979951?utm_source=gnollhack"><img src="~/img/app-store-badge-h200-noborders.webp" alt="Download on the App Store" loading="lazy" class="shiny-borders apple-app-store" /></a>
                </div>
            </div>

            <div class="download-link-outer-container">
                <div class="download-link-container" data-bs-toggle="tooltip" data-bs-placement="top"
                     data-bs-custom-class="download-link-tooltip"
                     data-bs-title="Windows & Linux">
                    <a href="https://store.steampowered.com/app/3558190/GnollHack/?utm_source=gnollhack">
                        <img src="~/img/steambadge-noborders.webp" alt="Available on Steam" loading="lazy" class="shiny-borders steam" />
                    </a>
                </div>
            </div>

            <div class="download-link-outer-container">
                <div class="download-link-container" data-bs-toggle="tooltip" data-bs-placement="top"
                     data-bs-custom-class="download-link-tooltip"
                     data-bs-title="Windows: Legacy & MSIX, Linux: AppImage">
                    <a href="https://github.com/hyvanmielenpelit/GnollHack/releases">
                        <img src="~/img/GitHubDownloadBadge-NoBorders-h200.webp" alt="Get release on GitHub" loading="lazy" class="shiny-borders github-releases" />
                    </a>
                </div>
            </div>

            <h2>What is GnollHack?</h2>
            <div class="description-center">
                <div class="description">
                    GnollHack is the modern way to play the legendary <a href="https://www.nethack.org" target="_blank" rel="noopener noreferrer" class="free">NetHack</a>,
                    the deepest <i>traditional roguelike</i> ever made.
                    The classic game has been enhanced with artist-drawn graphics, full voice acting, and a streamlined interface,
                    all without sacrificing the hardcore depth roguelike players love.
                </div>
            </div>
            <div class="readmore">
                <p class="whatis">Learn more on the <a href="https://wiki.gnollhack.com" target="_blank" rel="noopener noreferrer" class="free">wiki</a> or ask the <a href="https://overseer.gnollhack.com" target="_blank" rel="noopener noreferrer" class="free">Gnoll Overseer</a>!</p>
            </div>
        </div>
    </div>
</section>

<section class="left-section orc-hunter">
    <div class="backdrop">
        <div class="features-text">
            <h2>Videos and Screenshots</h2>
            <div class="carousel-container">
                @await Html.PartialAsync("_Carousel", Model.MediaItems)
            </div>
        </div>
    </div>
</section>

<section class="right-section female-mage">
    <div class="backdrop">
        <div class="features-text">
            <h2>Features</h2>
            <div class="imgContainer extra-padding">
                <img src="~/img/human_wizard_female.webp" alt="Human Wizard" loading="lazy" width="64" height="96" />
            </div>
            <h3>Challenge Your Wits</h3>
            <p>Perfect your strategies in a turn-based roguelike adventure game in which you build up your knowledge of the dungeon's secrets to overcome impossible odds.</p>

            <div class="imgContainer extra-padding">
                <img src="~/img/human_rogue_male.webp" alt="Human Rogue" loading="lazy" width="64" height="96" />
            </div>
            <h3>Modernized for Today's Players</h3>
            <div class="block-centered-text-left-align">
                <div>
                    <ul>
                        <li><b>Artist-drawn graphics</b> &mdash; 23,000+ tiles &amp; animations</li>
                        <li><b>Full voice acting</b> &mdash; 96 voice actors</li>
                        <li><b>Gnoll Overseer</b> &mdash; Optional, highly advanced AI assistant to help you master the game</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="left-section barbarian">
    <div class="backdrop">
        <div class="features-text">
            <div class="imgContainer extra-padding">
                <img src="~/img/gnoll_barbarian_male.webp" alt="Gnoll Barbarian" loading="lazy" width="64" height="96" />
            </div>
            <h3>Endless Replayability</h3>
            <div class="block-centered-text-left-align">
                <div>
                    <ul>
                        <li><b>Randomized dungeons</b> &mdash; No two runs alike</li>
                        <li><b>Deep builds</b> &mdash; 13 classes, 5 races, 200+ spells &amp; mythic gear</li>
                        <li><b>Your stakes</b> &mdash; 7 difficulty levels, checkpoints or permadeath</li>
                    </ul>
                </div>
            </div>

            <div class="imgContainer extra-padding">
                <img src="~/img/stormbringer.webp" alt="Stormbringer" loading="lazy" width="64" height="48" />
            </div>
            <h3>Free and Accessible</h3>
            <div class="block-centered-text-left-align">
                <div>
                    <ul>
                        <li><b>Free to play</b> &mdash; No ads or microtransactions</li>
                        <li><b>Play anywhere</b> &mdash; Mobile, desktop, and Steam Deck</li>
                        <li><b>All input methods</b> &mdash; Touch, mouse, keyboard, and controller</li>
                        <li><b>Open source</b></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="right-section dwarf-monk">
    <div class="backdrop">
        <div class="features-text">
            <h2>Learn the Game</h2>
            <ul class="resource-grid" role="list">
                <li class="resource-card">
                    <a class="resource-link" href="https://overseer.gnollhack.com" target="_blank" rel="noopener noreferrer" aria-describedby="desc-overseer">Gnoll Overseer</a>
                    <span id="desc-overseer" class="resource-desc">Optional AI coach, benchmarked for accuracy</span>
                    <span class="resource-arrow" aria-hidden="true">&#8599;</span>
                </li>
                <li class="resource-card">
                    <a class="resource-link" href="https://wiki.gnollhack.com" target="_blank" rel="noopener noreferrer" aria-describedby="desc-gh-wiki">GnollHack Wiki</a>
                    <span id="desc-gh-wiki" class="resource-desc">Mechanics, guides &amp; strategy</span>
                    <span class="resource-arrow" aria-hidden="true">&#8599;</span>
                </li>
                <li class="resource-card">
                    <a class="resource-link" href="https://nethackwiki.com" target="_blank" rel="noopener noreferrer" aria-describedby="desc-nh-wiki">NetHack Wiki</a>
                    <span id="desc-nh-wiki" class="resource-desc">Reference for the original game</span>
                    <span class="resource-arrow" aria-hidden="true">&#8599;</span>
                </li>
            </ul>

            <h2>Community</h2>
            <ul class="resource-grid" role="list">
                <li class="resource-card">
                    <a class="resource-link" href="https://discord.gg/cQuExnzUQy" target="_blank" rel="noopener noreferrer" aria-describedby="desc-discord">GnollHack Discord</a>
                    <span id="desc-discord" class="resource-desc">Chat with other players</span>
                    <span class="resource-arrow" aria-hidden="true">&#8599;</span>
                </li>
                <li class="resource-card">
                    <a class="resource-link" href="https://account.gnollhack.com" target="_blank" rel="noopener noreferrer" aria-describedby="desc-account">GnollHack Account</a>
                    <span id="desc-account" class="resource-desc">Top scores, bones sharing &amp; cloud saves</span>
                    <span class="resource-arrow" aria-hidden="true">&#8599;</span>
                </li>
                <li class="resource-card">
                    <a class="resource-link" href="https://github.com/hyvanmielenpelit/GnollHack" target="_blank" rel="noopener noreferrer" aria-describedby="desc-github">GitHub Repository</a>
                    <span id="desc-github" class="resource-desc">Open-source C &amp; .NET MAUI code</span>
                    <span class="resource-arrow" aria-hidden="true">&#8599;</span>
                </li>
            </ul>
        </div>
    </div>
</section>

@await Html.PartialAsync("_FullscreenModal", Model.MediaItems)

@section Styles {
    <link rel="stylesheet" href="~/css/carousel.min.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/carousel.js" asp-append-version="true" type="text/javascript"></script>
}